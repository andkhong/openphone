 {
  "name": "a purchase is one prompt: Buy now asks, Place your order is covered",
  "tags": [
   "friction",
   "permits"
  ],
  "steps": [
   {
    "call": {
     "method": "tap",
     "params": {
      "x": 540,
      "y": 1720
     }
    },
    "screen": "amazon_product",
    "expect": {
     "decision": "ask",
     "code": "gate_needs_approval",
     "kind": "pay",
     "money": "start"
    }
   },
   {
    "approve": "last",
    "sig": "valid"
   },
   {
    "call": {
     "method": "tap",
     "params": {
      "x": 540,
      "y": 1720
     }
    },
    "screen": "amazon_product",
    "expect": {
     "decision": "allow"
    }
   },
   {
    "call": {
     "method": "tap",
     "params": {
      "x": 540,
      "y": 1660
     }
    },
    "screen": "amazon_checkout",
    "expect": {
     "decision": "allow",
     "rule": "permit:purchase_flow"
    }
   },
   {
    "call": {
     "method": "tap",
     "params": {
      "x": 540,
      "y": 1660
     }
    },
    "screen": "amazon_checkout",
    "expect": {
     "decision": "ask",
     "code": "gate_needs_approval",
     "kind": "pay",
     "money": "terminal"
    }
   }
  ]
 },
