#!/usr/bin/env bash
# om: run and switch between the two OpenMob test environments.
#
#   standard    ~/Desktop/openmob            branch main           data ~/.config/openmob
#   gatekeeper  ~/Desktop/openmob-gatekeeper branch gatekeeper-p1  data ~/.config/openmob-gatekeeper
#
# Setup once: git worktree add --detach ~/Desktop/openmob-gatekeeper origin/gatekeeper-p1, give it its own
# .venv (python3 -m venv .venv && .venv/bin/pip install -e .), copy config.yaml, and copy the data dir.
# See docs/dev-environments.md. Paths can be changed with OPENMOB_{STANDARD,GATEKEEPER}_{DIR,DATA}.
#
# Usage:
#   om run <env> [port]        start that environment's server (default port 8765; one at a time)
#   om phone <env> [serial]    install that environment's app on the phone (or emulator serial)
#   om build <env> [signed]    build that environment's app from its code (signed: the owner's key, not
#                              debuggable, for the owner's own phone; plain builds stay debug, for emulators)
#   om release                 build the hosted server's download (main, the owner's key, https only) into
#                              deploy/OpenMob.apk
#   om keygen                  create the owner's release key (interactive; run it in your own terminal)
#   om update <env>            pull the latest code for that environment and refresh its Python packages
#   om status                  what's checked out, what's running, which app the phone has
set -euo pipefail

ENVS="${OPENMOB_ENVS_HOME:-$HOME/.config/openmob-envs}"   # built apps and the phone-app record (not in git)
APKS="$ENVS/apk"
STATE="$ENVS/phone-app"
mkdir -p "$APKS"
export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@17}"
export ANDROID_HOME="${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}"

env_dir()    { case "$1" in standard) echo "${OPENMOB_STANDARD_DIR:-$HOME/Desktop/openmob}";; gatekeeper) echo "${OPENMOB_GATEKEEPER_DIR:-$HOME/Desktop/openmob-gatekeeper}";; *) die "unknown environment '$1' (standard or gatekeeper)";; esac; }
env_data()   { case "$1" in standard) echo "${OPENMOB_STANDARD_DATA:-$HOME/.config/openmob}";; gatekeeper) echo "${OPENMOB_GATEKEEPER_DATA:-$HOME/.config/openmob-gatekeeper}";; esac; }
env_branch() { case "$1" in standard) echo "main";; gatekeeper) echo "gatekeeper-p1";; esac; }
die() { echo "om: $*" >&2; exit 1; }

cmd_run() {
  local env="${1:-}" port="${2:-8765}"; [ -n "$env" ] || die "usage: om run <standard|gatekeeper> [port]"
  local dir data; dir="$(env_dir "$env")"; data="$(env_data "$env")"
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "port $port is already in use (another OpenMob server?). Stop it (Control + C in its terminal) or pick another port: om run $env 8766"
  fi
  # om build stores the matching phone app here, including builds made in scratch worktrees.
  if [ -z "${OPENMOB_APK:-}" ] && [ -f "$APKS/$env.apk" ]; then
    export OPENMOB_APK="$APKS/$env.apk"
  fi
  if [ ! -r "$data/provider-keys.env" ] && [ -z "${ANTHROPIC_API_KEY:-}${OPENAI_API_KEY:-}${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}${QWEN_API_KEY:-}${DASHSCOPE_API_KEY:-}${XAI_API_KEY:-}${OPENAI_COMPATIBLE_BASE_URL:-}" ]; then
    echo "om: warning: no model-provider key or compatible endpoint is set in this terminal." >&2
  fi
  local phone_env; phone_env="$(cut -d' ' -f1 "$STATE" 2>/dev/null || true)"
  if [ -n "$phone_env" ] && [ "$phone_env" != "$env" ]; then
    echo "om: warning: the phone has the $phone_env app, not the $env one. Run 'om phone $env' (or 'om run $phone_env') so they match." >&2
  fi
  echo "▶ OpenMob $env  ·  $(git -C "$dir" log --oneline -1)  ·  data $data  ·  port $port"
  cd "$dir"
  OPENMOB_DATA_DIR="$data" OPENMOB_PORT="$port" exec .venv/bin/python -c "
import sys, os, shlex
from pathlib import Path
# Load private key assignments as data, never execute them as shell commands.
keys_file = Path(os.environ['OPENMOB_DATA_DIR']) / 'provider-keys.env'
if keys_file.is_file():
    if keys_file.stat().st_mode & 0o077:
        sys.exit(f'provider-keys.env can be read by other users; keys were not loaded. Run: chmod 600 {keys_file}')
    allowed = {'ANTHROPIC_API_KEY', 'OPENAI_API_KEY', 'GEMINI_API_KEY', 'GOOGLE_API_KEY',
               'QWEN_API_KEY', 'DASHSCOPE_API_KEY', 'XAI_API_KEY', 'QWEN_BASE_URL', 'XAI_BASE_URL',
               'OPENAI_COMPATIBLE_API_KEY', 'TYPESAFE_API_KEY', 'ANTHROPIC_WORKSPACE_ID'}
    saved = {}
    for line in keys_file.read_text().splitlines():
        try:
            parts = shlex.split(line, comments=True)
        except ValueError:
            sys.exit('provider-keys.env has invalid quoting; keys were not loaded.')
        if parts and parts[0] == 'export':
            parts = parts[1:]
        if not parts:
            continue
        if len(parts) != 1 or '=' not in parts[0]:
            sys.exit('provider-keys.env: expected NAME=value or export NAME=value.')
        name, value = parts[0].split('=', 1)
        if name not in allowed:
            sys.exit('provider-keys.env contains an unsupported variable; keys were not loaded.')
        if value:
            saved[name] = value
    os.environ.update(saved)
if not os.environ.get('TYPESAFE_API_KEY'):
    print('om: warning: TYPESAFE_API_KEY is set neither in this terminal nor in provider-keys.env; Jev will be off.',
          file=sys.stderr)
if not os.environ.get('ANTHROPIC_API_KEY'):
    print('om: warning: ANTHROPIC_API_KEY is set neither in this terminal nor in provider-keys.env; Claude models '
          'will be unavailable.', file=sys.stderr)
from openmob.config import load_config
import openmob.main as m
cfg_load = m.load_config
def load(path=None):
    cfg = cfg_load(path)
    cfg.server_port = int(os.environ['OPENMOB_PORT'])
    return cfg
m.load_config = load
sys.argv = ['openmob', 'run', '--no-adb', '--quiet', '--accounts']
m.main()
"
}

SIGNING="${OPENMOB_SIGNING:-$ENVS/release-signing.properties}"

cmd_build() {
  local env="${1:-}" kind="${2:-}"; [ -n "$env" ] || die "usage: om build <standard|gatekeeper> [signed]"
  local dir; dir="$(env_dir "$env")"
  [ -f "$dir/android/local.properties" ] || cp "$(env_dir standard)/android/local.properties" "$dir/android/" 2>/dev/null || true
  if [ "$kind" = signed ]; then
    [ -f "$SIGNING" ] || die "no release key yet: run 'om keygen' in your own terminal first."
    echo "▶ building the signed $env app ($(git -C "$dir" log --oneline -1))…"
    (cd "$dir/android" && OPENMOB_SIGNING="$SIGNING" ./gradlew -q assembleLocal)
    mkdir -p "$APKS" && cp "$dir/android/app/build/outputs/apk/local/app-local.apk" "$APKS/$env.apk"
    echo signed > "$APKS/$env.kind"
  else
    echo "▶ building the $env app ($(git -C "$dir" log --oneline -1))…"
    (cd "$dir/android" && ./gradlew -q assembleDebug)
    mkdir -p "$APKS" && cp "$dir/android/app/build/outputs/apk/debug/app-debug.apk" "$APKS/$env.apk"
    echo debug > "$APKS/$env.kind"
  fi
  git -C "$dir" rev-parse --short HEAD > "$APKS/$env.commit"
  echo "✓ $APKS/$env.apk ($(cat "$APKS/$env.kind"), $(du -h "$APKS/$env.apk" | cut -f1))"
}

cmd_release() {
  local dir; dir="$(env_dir standard)"
  [ -f "$SIGNING" ] || die "no release key yet: run 'om keygen' in your own terminal first."
  [ "$(git -C "$dir" branch --show-current)" = main ] || die "the release is built from main; check out main in $dir first."
  echo "▶ building the release app ($(git -C "$dir" log --oneline -1))…"
  (cd "$dir/android" && OPENMOB_SIGNING="$SIGNING" ./gradlew -q assembleRelease)
  cp "$dir/android/app/build/outputs/apk/release/app-release.apk" "$dir/deploy/OpenMob.apk"
  git -C "$dir" rev-parse --short HEAD > "$APKS/release.commit"
  echo "✓ $dir/deploy/OpenMob.apk (release, $(du -h "$dir/deploy/OpenMob.apk" | cut -f1)). Deploy: fly deploy -a openmob"
}

cmd_keygen() {
  [ -f "$SIGNING" ] && die "a release key already exists ($SIGNING). Keep it: phones only accept updates signed with it."
  local store="$ENVS/release.jks" pass pass2
  command -v keytool >/dev/null || PATH="$JAVA_HOME/bin:$PATH"
  echo "Creating OpenMob's release key. Back up $store and its password: losing either means every phone must"
  echo "uninstall and reinstall OpenMob (and pair again) to take updates."
  read -r -s -p "New key password (12+ characters): " pass; echo
  read -r -s -p "Again: " pass2; echo
  [ "$pass" = "$pass2" ] || die "the passwords don't match."
  [ "${#pass}" -ge 12 ] || die "use at least 12 characters."
  umask 077
  OM_PASS="$pass" keytool -genkeypair -keystore "$store" -storetype PKCS12 -alias openmob -keyalg RSA \
    -keysize 4096 -validity 10000 -dname "CN=OpenMob, O=OpenMob" -storepass:env OM_PASS -keypass:env OM_PASS \
    >/dev/null || die "keytool failed; nothing was saved."
  printf 'storeFile=%s\nstorePassword=%s\nkeyAlias=openmob\nkeyPassword=%s\n' "$store" "$pass" "$pass" > "$SIGNING"
  chmod 600 "$SIGNING" "$store"
  echo "✓ release key: $store; its settings: $SIGNING (readable by you only). Its fingerprint:"
  OM_PASS="$pass" keytool -list -v -keystore "$store" -storetype PKCS12 -storepass:env OM_PASS -alias openmob \
    | grep -E "SHA256:" | sed 's/^[[:space:]]*/  /'
}

cmd_phone() {
  local env="${1:-}" serial="${2:-${ANDROID_SERIAL:-}}"; [ -n "$env" ] || die "usage: om phone <standard|gatekeeper> [serial]"
  [ -f "$APKS/$env.apk" ] || cmd_build "$env"
  local adb=(adb); [ -n "$serial" ] && adb=(adb -s "$serial")
  "${adb[@]}" get-state >/dev/null 2>&1 || die "no phone reachable over adb. Unlock it, allow USB debugging, and check Samsung Auto Blocker is off."
  echo "▶ installing the $env app ($(cat "$APKS/$env.commit" 2>/dev/null || echo '?')) on $("${adb[@]}" shell getprop ro.product.model | tr -d '\r')…"
  "${adb[@]}" install -r "$APKS/$env.apk" | tail -1
  echo "$env $(cat "$APKS/$env.commit" 2>/dev/null) $(date '+%F %T')" > "$STATE"
  echo "✓ now open OpenMob on the phone and tap Connect (start the matching server: om run $env)"
}

cmd_update() {
  local env="${1:-}"; [ -n "$env" ] || die "usage: om update <standard|gatekeeper>"
  local dir branch; dir="$(env_dir "$env")"; branch="$(env_branch "$env")"
  git -C "$dir" fetch -q origin
  if [ "$env" = standard ]; then git -C "$dir" checkout -q main && git -C "$dir" merge -q --ff-only origin/main
  else git -C "$dir" checkout -q --detach "origin/$branch"; fi
  (cd "$dir" && .venv/bin/pip install -q -e . 2>&1 | grep -v notice || true)
  echo "✓ $env is at $(git -C "$dir" log --oneline -1). Rebuild its app with: om build $env"
}

cmd_status() {
  for env in standard gatekeeper; do
    local dir; dir="$(env_dir "$env")"
    printf '%-11s code %-48s app %s\n' "$env" "$(git -C "$dir" log --oneline -1 | cut -c1-48)" "$( [ -f "$APKS/$env.apk" ] && echo "built ($(cat "$APKS/$env.commit" 2>/dev/null))" || echo 'not built')"
  done
  echo "servers:"
  lsof -nP -a -iTCP -sTCP:LISTEN -c Python 2>/dev/null | awk 'NR>1 && /:87[0-9][0-9]/ {print $2, $9}' | sort -u | while read -r pid addr; do
    cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
    case "$cwd" in *openmob-gatekeeper) which=gatekeeper;; */Desktop/openmob) which=standard;; *) which="other ($cwd)";; esac
    echo "  $which server, pid $pid, on $addr"
  done
  echo "phone app: $(cat "$STATE" 2>/dev/null || echo 'unknown (installed outside om)')"
}

case "${1:-}" in
  run) shift; cmd_run "$@";; phone) shift; cmd_phone "$@";; build) shift; cmd_build "$@";;
  release) cmd_release;; keygen) cmd_keygen;;
  update) shift; cmd_update "$@";; status) cmd_status;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//';;
esac
